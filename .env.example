# Clerk — from the Clerk dashboard → API keys (or `npx clerk env pull`)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Google Calendar via Composio — project API key from dashboard.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=
COMPOSIO_GCAL_AUTH_CONFIG_ID=
COMPOSIO_GCAL_VERSION=20261007_00

# Team knowledge base for agents — a Google service account key (whole JSON on one line)
# and the Drive folder it can read (share the folder with the service account's email)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=
# Folders never synced (comma-separated path prefixes); credential-like file names are always skipped
DRIVE_EXCLUDE=Sensitive/
